<ol reversed class="c-post-list">
{% for post in recommendedPostslist | reverse %}
	<li class="c-post-list__item c-post-list__item--no-counter{% if post.url == url %} c-post-list__item--active{% endif %}">
		<div>
			<a href="{{ post.url }}" class="c-post-list__link" style="view-transition-name: post-title-{{ post.url | slugify }}">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
			
			<div class="c-post-list__item-meta">
				<time class="c-post-list__date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("LLLL yyyy") }}</time>
				<span class="c-post-list__separator" aria-hidden="true">·</span>
				<span class="c-post-list__reading-time">{{ post.page.rawInput | readingTime }} read</span>
			<div>
		</div>
	</li>
{% endfor %}
</ol>
